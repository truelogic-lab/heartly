# Postgres connection (Supabase pooler URL — Session mode)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Server
PORT=4000
NODE_ENV=production
CLIENT_ORIGIN=https://your-frontend-domain.com,http://localhost:5173
