{
  "name": "heartly-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Heartly backend — Express API + Prisma repositories for the dating engine.",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
