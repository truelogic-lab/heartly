/* =========================================================
   Heartly — Complete stylesheet
   White + red marketing design. Mobile-first responsive.
   Sections: Tokens · Reset · Buttons · Header · Hero ·
   FeatureStrip · MeetSingles · Safety · Footer · Utilities
   ========================================================= */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

/* =========================================================
   TOKENS
   ========================================================= */
:root {
  --red: #E63946;
  --red-dark: #C42B37;
  --red-soft: #FFE8EA;
  --ink: #111114;
  --ink-2: #3a3a44;
  --muted: #6b6b78;
  --line: #ececf0;
  --bg: #ffffff;
  --bg-soft: #fafafc;
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-xl: 28px;
  --shadow-soft: 0 12px 32px rgba(17, 17, 20, 0.08);
  --shadow-phone: 0 30px 60px rgba(17, 17, 20, 0.18);
  --container: 1200px;
  --font: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
}

/* =========================================================
   RESET
   ========================================================= */
*,
*::before,
*::after { box-sizing: border-box; }

html, body {
  height: 100%;
  overflow-x: hidden;
  max-width: 100vw;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font);
  font-size: 16px;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

img { display: block; max-width: 100%; }
a { color: inherit; text-decoration: none; }
button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
ul { list-style: none; padding: 0; margin: 0; }

:focus-visible {
  outline: 2px solid var(--red);
  outline-offset: 2px;
  border-radius: 4px;
}

.text-accent { color: var(--red); }

/* =========================================================
   BUTTONS
   ========================================================= */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 22px;
  border-radius: 999px;
  font-size: 14px;
  font-weight: 700;
  transition: background 160ms ease, transform 160ms ease, box-shadow 160ms ease;
  text-decoration: none;
  border: 0;
  cursor: pointer;
  white-space: nowrap;
}

.btn--primary {
  background: var(--red);
  color: #fff;
  box-shadow: 0 8px 20px rgba(230, 57, 70, 0.25);
}
.btn--primary:hover {
  background: var(--red-dark);
  transform: translateY(-1px);
  box-shadow: 0 12px 26px rgba(230, 57, 70, 0.35);
}

.btn--sm { padding: 10px 18px; font-size: 13px; }

/* =========================================================
   HEADER
   ========================================================= */
.site-header {
  position: sticky;
  top: 0;
  z-index: 40;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: saturate(180%) blur(12px);
  border-bottom: 1px solid var(--line);
}

.site-header__inner {
  max-width: var(--container);
  margin: 0 auto;
  padding: 18px 32px;
  display: flex;
  align-items: center;
  gap: 40px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -0.3px;
  color: var(--ink);
  flex-shrink: 0;
}
.brand__icon { color: var(--red); font-size: 26px; }

.site-nav {
  display: flex;
  gap: 28px;
  flex: 1;
}

.site-nav__link {
  font-size: 14.5px;
  font-weight: 500;
  color: var(--ink-2);
  transition: color 140ms ease;
}
.site-nav__link:hover { color: var(--red); }

.site-header__actions {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-left: auto;
}

.site-header__burger {
  display: none;
  width: 40px;
  height: 40px;
  border-radius: 10px;
  color: var(--ink);
  align-items: center;
  justify-content: center;
  font-size: 22px;
  border: 1px solid var(--line);
  order: 2;
}

/* Mobile drawer */
.mobile-menu {
  border-top: 1px solid var(--line);
  background: #fff;
  padding: 12px 20px 20px;
  animation: fadeSlide 180ms ease;
}

.mobile-menu__nav { display: flex; flex-direction: column; gap: 2px; }

.mobile-menu__link {
  padding: 12px 8px;
  font-size: 15.5px;
  font-weight: 500;
  color: var(--ink-2);
  border-bottom: 1px solid var(--line);
}
.mobile-menu__link:hover { color: var(--red); }

.mobile-menu__cta { margin-top: 14px; align-self: flex-start; }

@keyframes fadeSlide {
  from { opacity: 0; transform: translateY(-6px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* =========================================================
   HERO
   ========================================================= */
.hero {
  position: relative;
  background: #fff;
  padding: 60px 0 0;
  overflow: hidden;
}

.hero__inner {
  max-width: var(--container);
  margin: 0 auto;
  padding: 0 32px 80px;
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 40px;
  align-items: center;
  position: relative;
  z-index: 2;
}

.hero__copy { max-width: 520px; position: relative; z-index: 5; }

.hero__title {
  font-size: clamp(44px, 6vw, 76px);
  line-height: 1.02;
  letter-spacing: -2px;
  font-weight: 900;
  color: var(--ink);
  margin: 0 0 24px;
}

.hero__heart {
  display: inline-block;
  color: var(--red);
  font-size: 0.55em;
  transform: translateY(-6px);
  margin-left: 6px;
}

.hero__lead {
  font-size: 17px;
  color: var(--ink-2);
  max-width: 420px;
  margin: 0 0 32px;
  line-height: 1.6;
}

.hero__store {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 36px;
}

.store-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 18px;
  background: #111;
  color: #fff;
  border-radius: 12px;
  transition: transform 160ms ease, background 160ms ease;
}
.store-btn:hover { transform: translateY(-2px); background: #000; }

.store-btn svg { font-size: 26px; }

.store-btn__text { display: flex; flex-direction: column; line-height: 1.1; }
.store-btn__text small {
  font-size: 10px;
  letter-spacing: 0.4px;
  opacity: 0.8;
  text-transform: uppercase;
}
.store-btn__text strong { font-size: 15px; font-weight: 700; }

.hero__social { display: flex; align-items: center; gap: 16px; }

.hero__avatars { display: flex; }

.hero__avatar {
  position: relative;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  overflow: hidden;
  background: #ececf0;
  border: 2px solid #fff;
  box-shadow: 0 2px 8px rgba(17, 17, 20, 0.12);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: -12px;
  flex-shrink: 0;
}
.hero__avatar:first-child { margin-left: 0; }

.hero__avatar img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  z-index: 2;
}

.hero__social-copy { display: flex; flex-direction: column; margin: 0; line-height: 1.3; }
.hero__social-copy strong { font-size: 14px; font-weight: 700; }
.hero__social-copy span { font-size: 13px; color: var(--muted); }

/* Hero phones */
.hero__phones {
  position: relative;
  min-height: 560px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 0 40px;
  overflow: visible;
}

.hero__phone {
  background: transparent;
  box-shadow: none;
  border: 0;
  border-radius: 0;
  overflow: visible;
  aspect-ratio: auto;
  height: auto;
}

.hero__phone img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
  border-radius: 0;
}

.hero__phone--front {
  position: relative;
  width: 320px;
  max-width: none;
  margin: 0 -30px 0 0;
  transform: rotate(-4deg);
  transform-origin: bottom center;
  z-index: 2;
}

.hero__phone--back {
  position: relative;
  width: 260px;
  max-width: none;
  margin: 0 0 40px -20px;
  transform: rotate(6deg);
  transform-origin: bottom center;
  z-index: 1;
}

.hero__bg-red {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 42%;
  background: var(--red);
  border-top-left-radius: 32px;
  border-top-right-radius: 32px;
  z-index: 0;
  pointer-events: none;
}

/* =========================================================
   FEATURE STRIP
   ========================================================= */
.feature-strip {
  background: var(--red);
  color: #fff;
  padding: 56px 32px 64px;
  border-radius: 32px;
  max-width: var(--container);
  margin: 0 auto 80px;
  position: relative;
  z-index: 3;
  box-shadow: 0 30px 60px rgba(230, 57, 70, 0.18);
}

.feature-strip__title {
  font-size: 26px;
  font-weight: 800;
  letter-spacing: -0.5px;
  margin: 0 0 40px;
}

.feature-strip__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
}

.feature-card { display: flex; flex-direction: column; gap: 14px; }

.feature-card__icon {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
}

.feature-card__title {
  font-size: 17px;
  font-weight: 700;
  margin: 0;
  letter-spacing: -0.2px;
}

.feature-card__copy {
  font-size: 14px;
  line-height: 1.55;
  opacity: 0.9;
  margin: 0;
}

/* =========================================================
   MEET SINGLES
   ========================================================= */
.meet {
  background: #fff;
  padding: 20px 32px 100px;
}

.meet__inner {
  max-width: var(--container);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 60px;
  align-items: center;
}

.meet__title {
  font-size: clamp(32px, 4vw, 44px);
  font-weight: 900;
  letter-spacing: -1.4px;
  margin: 0 0 14px;
  color: var(--ink);
  line-height: 1.1;
}

.meet__lead {
  font-size: 16px;
  color: var(--ink-2);
  margin: 0 0 36px;
  max-width: 380px;
}

.meet__list { display: flex; flex-direction: column; gap: 24px; }

.meet__item { display: flex; gap: 16px; align-items: flex-start; }

.meet__icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: var(--red-soft);
  color: var(--red);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  flex-shrink: 0;
}

.meet__item-title { font-size: 16px; font-weight: 700; margin: 0 0 4px; color: var(--ink); }
.meet__item-copy { font-size: 14px; color: var(--muted); margin: 0; max-width: 300px; }

.meet__phones {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  align-items: center;
}

.meet__phone {
  background: transparent;
  box-shadow: none;
  border: 0;
  border-radius: 0;
  overflow: visible;
  aspect-ratio: auto;
  height: auto;
}

.meet__phone img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
  border-radius: 0;
}

/* =========================================================
   SAFETY
   ========================================================= */
.safety {
  background: var(--bg-soft);
  padding: 80px 32px;
}

.safety__inner {
  max-width: var(--container);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 2.2fr;
  gap: 60px;
  align-items: start;
}

.safety__icon {
  width: 56px;
  height: 56px;
  border-radius: 16px;
  background: var(--red);
  color: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  margin-bottom: 20px;
}

.safety__title {
  font-size: clamp(26px, 3vw, 34px);
  font-weight: 900;
  letter-spacing: -1px;
  margin: 0 0 14px;
  color: var(--ink);
  line-height: 1.15;
}

.safety__copy {
  font-size: 15px;
  color: var(--ink-2);
  margin: 0;
  line-height: 1.6;
  max-width: 340px;
}

.safety__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.safety__item { display: flex; flex-direction: column; gap: 12px; }

.safety__item-icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #fff;
  color: var(--red);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  box-shadow: var(--shadow-soft);
}

.safety__item-title { font-size: 15px; font-weight: 700; margin: 0; color: var(--ink); }
.safety__item-copy { font-size: 13.5px; color: var(--muted); margin: 0; line-height: 1.55; }

/* =========================================================
   FOOTER
   ========================================================= */
.site-footer {
  background: var(--red);
  color: #fff;
  padding: 56px 32px 28px;
}

.site-footer__top {
  max-width: var(--container);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1.2fr 2.8fr;
  gap: 60px;
  padding-bottom: 40px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.18);
}

.site-footer__brand-col { display: flex; flex-direction: column; gap: 16px; }

.site-footer .brand--footer {
  font-size: 24px;
  color: #fff;
  gap: 10px;
}
.site-footer .brand--footer .brand__icon { color: #fff; font-size: 28px; }

.site-footer__tag {
  font-size: 14.5px;
  line-height: 1.55;
  opacity: 0.92;
  margin: 0;
  max-width: 260px;
}

.site-footer__social { display: flex; gap: 12px; margin-top: 4px; }

.site-footer__social a {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: #fff;
  transition: background 160ms ease, transform 160ms ease;
}
.site-footer__social a:hover {
  background: rgba(255, 255, 255, 0.32);
  transform: translateY(-2px);
}

.site-footer__cols {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
}

.site-footer__col-title {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.2px;
  margin: 0 0 16px;
  color: #fff;
  opacity: 0.95;
}

.site-footer__col-list { display: flex; flex-direction: column; gap: 12px; }

.site-footer__col-list a {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.85);
  transition: color 140ms ease, opacity 140ms ease;
}
.site-footer__col-list a:hover {
  color: #fff;
  opacity: 1;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.site-footer__bottom {
  max-width: var(--container);
  margin: 0 auto;
  padding-top: 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.85);
}

.site-footer__copy,
.site-footer__made { margin: 0; }

.site-footer__made { display: inline-flex; align-items: center; gap: 6px; }
.site-footer__made-heart { color: #fff; font-size: 14px; opacity: 0.9; }

/* =========================================================
   RESPONSIVE — 1440
   ========================================================= */
@media (max-width: 1440px) {
  .site-header__inner,
  .hero__inner,
  .meet__inner,
  .safety__inner,
  .site-footer__inner { padding-left: 28px; padding-right: 28px; }
}

/* =========================================================
   RESPONSIVE — 1200
   ========================================================= */
@media (max-width: 1200px) {
  .site-header__inner { padding: 16px 24px; gap: 24px; }
  .site-nav { gap: 20px; }
  .site-nav__link { font-size: 14px; }

  .hero__inner { padding: 0 24px 60px; gap: 32px; }
  .hero__phone--front { width: 290px; }
  .hero__phone--back { width: 235px; }

  .feature-strip { padding: 48px 28px 56px; border-radius: 28px; }
  .meet__inner { gap: 40px; }
  .safety__inner { gap: 40px; }
}

/* =========================================================
   RESPONSIVE — 1024
   ========================================================= */
@media (max-width: 1024px) {
  /* Header */
  .site-header__inner { padding: 16px 24px; }
  .site-nav { gap: 18px; }
  .site-nav__link { font-size: 13.5px; }

  /* Hero */
  .hero { padding-top: 40px; }
  .hero__inner { padding: 0 24px 60px; gap: 30px; }
  .hero__title { font-size: clamp(40px, 6.5vw, 64px); letter-spacing: -1.6px; }
  .hero__phone--front { width: 270px; margin-right: -26px; }
  .hero__phone--back { width: 220px; margin-bottom: 34px; }
  .hero__bg-red { height: 40%; }

  /* Feature strip */
  .feature-strip { padding: 44px 24px 52px; border-radius: 26px; margin: 0 20px 64px; }
  .feature-strip__title { font-size: 24px; margin-bottom: 32px; }
  .feature-strip__grid { gap: 22px; }
  .feature-card__title { font-size: 16px; }
  .feature-card__copy { font-size: 13.5px; }

  /* Meet */
  .meet { padding: 20px 24px 80px; }
  .meet__inner { gap: 32px; }
  .meet__title { font-size: clamp(28px, 4.5vw, 38px); }
  .meet__phones { gap: 14px; }

  /* Safety */
  .safety { padding: 64px 24px; }
  .safety__inner { gap: 32px; }
  .safety__grid { gap: 20px; }

  /* Footer */
  .site-footer { padding: 48px 24px 24px; }
  .site-footer__top { grid-template-columns: 1fr; gap: 40px; }
  .site-footer__cols { grid-template-columns: repeat(2, 1fr); gap: 28px; }
}

/* =========================================================
   RESPONSIVE — 900 (tablet portrait — nav collapses)
   ========================================================= */
@media (max-width: 900px) {
  /* Header */
  .site-header__inner { padding: 14px 20px; gap: 16px; justify-content: space-between; }
  .site-nav { display: none; }
  .site-header__actions .btn { display: none; }
  .site-header__burger { display: inline-flex; }
  .site-header__actions { margin-left: auto; gap: 8px; }
  .brand { font-size: 20px; }

  /* Hero — stack copy above phones */
  .hero { padding-top: 32px; }
  .hero__inner { grid-template-columns: 1fr; gap: 32px; padding: 0 20px 60px; }
  .hero__copy { max-width: 640px; }
  .hero__title { font-size: clamp(38px, 8vw, 56px); letter-spacing: -1.4px; }
  .hero__lead { font-size: 16px; max-width: 100%; margin-bottom: 26px; }
  .hero__store { gap: 10px; margin-bottom: 28px; }
  .store-btn { padding: 9px 16px; }
  .store-btn svg { font-size: 22px; }
  .store-btn__text strong { font-size: 14px; }

  .hero__phones {
    min-height: 440px;
    padding: 12px 0 0;
    align-items: flex-end;
  }
  .hero__phone--front { width: 220px; max-width: 62%; margin-right: -20px; }
  .hero__phone--back { width: 195px; max-width: 55%; margin-bottom: 24px; margin-left: -14px; }
  .hero__bg-red { height: 36%; border-radius: 24px 24px 0 0; }
  .hero__avatar { width: 42px; height: 42px; }

  /* Feature strip */
  .feature-strip { padding: 40px 22px 46px; border-radius: 24px; margin: 0 16px 56px; }
  .feature-strip__title { font-size: 22px; margin-bottom: 26px; }
  .feature-strip__grid { grid-template-columns: repeat(2, 1fr); gap: 22px; }
  .feature-card__icon { width: 42px; height: 42px; font-size: 20px; }

  /* Meet */
  .meet { padding: 10px 20px 70px; }
  .meet__inner { grid-template-columns: 1fr; gap: 30px; }
  .meet__title { font-size: clamp(26px, 6vw, 34px); }
  .meet__lead { max-width: 100%; margin-bottom: 28px; }
  .meet__item-copy { max-width: 100%; }
  .meet__phones { gap: 14px; }

  /* Safety */
  .safety { padding: 56px 20px; }
  .safety__inner { grid-template-columns: 1fr; gap: 30px; }
  .safety__copy { max-width: 100%; }
  .safety__grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }

  /* Footer */
  .site-footer { padding: 44px 20px 22px; }
  .site-footer__tag { max-width: 100%; }
}

/* =========================================================
   RESPONSIVE — 768
   ========================================================= */
@media (max-width: 768px) {
  .hero__inner { padding: 0 18px 50px; gap: 28px; }
  .hero__title { font-size: clamp(34px, 8.5vw, 48px); letter-spacing: -1.2px; }
  .hero__heart { font-size: 0.5em; transform: translateY(-4px); margin-left: 4px; }
  .hero__lead { font-size: 15.5px; line-height: 1.55; margin-bottom: 24px; }
  .hero__store { flex-direction: column; align-items: stretch; gap: 10px; }
  .store-btn { justify-content: center; padding: 11px 18px; }

  .hero__phones { min-height: 400px; }
  .hero__phone--front { width: 200px; margin-right: -18px; }
  .hero__phone--back { width: 175px; margin-bottom: 20px; margin-left: -12px; }
  .hero__bg-red { height: 34%; border-radius: 20px 20px 0 0; }
  .hero__avatar { width: 40px; height: 40px; }

  .feature-strip { padding: 34px 20px 40px; border-radius: 20px; margin: 0 12px 48px; }
  .feature-strip__title { font-size: 20px; margin-bottom: 24px; }
  .feature-strip__grid { grid-template-columns: 1fr; gap: 22px; }
  .feature-card__icon { width: 40px; height: 40px; font-size: 19px; }
  .feature-card__title { font-size: 15.5px; }
  .feature-card__copy { font-size: 13.5px; }

  .meet { padding: 0 18px 60px; }
  .meet__inner { gap: 26px; }
  .meet__title { font-size: clamp(24px, 7vw, 30px); letter-spacing: -0.9px; }
