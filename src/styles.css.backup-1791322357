/* =========================================================
   POLISH PASS — global refinement layer
   Nothing structural. Only feel, motion, a11y, contrast.
   ========================================================= */

/* ---------------------------------------------------------
   1. Page container — smooth scroll, no chaining
   --------------------------------------------------------- */
html {
  scroll-behavior: smooth;
  overscroll-behavior-y: none;
  -webkit-tap-highlight-color: transparent;
}

body {
  text-wrap: pretty;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

/* Custom scrollbar for desktop */
@media (hover: hover) and (pointer: fine) {
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb {
    background: rgba(230, 57, 70, 0.25);
    border-radius: 999px;
    border: 2px solid transparent;
    background-clip: padding-box;
  }
  ::-webkit-scrollbar-thumb:hover { background: rgba(230, 57, 70, 0.5); background-clip: padding-box; }
}

/* ---------------------------------------------------------
   2. Focus rings — visible, branded, only when needed
   --------------------------------------------------------- */
:focus { outline: none; }

:focus-visible {
  outline: 2px solid var(--red);
  outline-offset: 3px;
  border-radius: 6px;
  box-shadow: 0 0 0 4px rgba(230, 57, 70, 0.15);
}

/* Remove focus ring from mouse clicks but keep for keyboard */
button:focus:not(:focus-visible),
a:focus:not(:focus-visible),
input:focus:not(:focus-visible),
select:focus:not(:focus-visible),
textarea:focus:not(:focus-visible) {
  outline: none;
  box-shadow: none;
}

/* ---------------------------------------------------------
   3. Text selection — branded
   --------------------------------------------------------- */
::selection {
  background: rgba(230, 57, 70, 0.22);
  color: var(--ink);
}

::-moz-selection {
  background: rgba(230, 57, 70, 0.22);
  color: var(--ink);
}

/* ---------------------------------------------------------
   4. Typography polish
   --------------------------------------------------------- */
h1, h2, h3, h4, h5, h6 {
  text-wrap: balance;
  letter-spacing: -0.3px;
}

p {
  text-wrap: pretty;
}

/* Slightly tighter tracking on big display text */
.hero__title,
.match-page__title,
.auth-card__title,
.upload__title,
.phone__title,
.app-home__headline,
.meet__title,
.safety__title,
.swipe-card__name,
.detail__title {
  letter-spacing: -0.5px;
  text-wrap: balance;
}

/* Kill default text-indent and quotes on blockquote/figcaption if any */
blockquote { text-wrap: pretty; }

/* ---------------------------------------------------------
   5. Button & link states — consistent across the app
   --------------------------------------------------------- */
button,
a,
input[type="submit"],
input[type="button"] {
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
}

/* Active state — a subtle squeeze */
button:active:not(:disabled),
a:active:not(:disabled) {
  transform: scale(0.98);
}

/* Anchor transitions */
a { transition: color 160ms ease, background-color 160ms ease, opacity 160ms ease; }

/* Prevent double-tap zoom on buttons (mobile) */
button { touch-action: manipulation; }

/* ---------------------------------------------------------
   6. Media polish
   --------------------------------------------------------- */
img,
video {
  max-width: 100%;
  height: auto;
  -webkit-user-drag: none;
  user-select: none;
}

/* Prevent layout shift on slow-loading images */
img[loading="lazy"] {
  content-visibility: auto;
}

/* ---------------------------------------------------------
   7. Form polish
   --------------------------------------------------------- */
input,
select,
textarea {
  font-family: inherit;
  transition: border-color 160ms ease, background-color 160ms ease, box-shadow 160ms ease;
}

input::placeholder,
textarea::placeholder {
  color: #9a9aa6;
  opacity: 1;
}

/* Disabled inputs */
input:disabled,
select:disabled,
textarea:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

/* Remove iOS default input styling */
input[type="search"]::-webkit-search-decoration,
input[type="search"]::-webkit-search-cancel-button {
  -webkit-appearance: none;
  appearance: none;
}

/* Remove autofill yellow/blue */
input:-webkit-autofill,
input:-webkit-autofill:hover,
input:-webkit-autofill:focus {
  -webkit-box-shadow: 0 0 0 1000px #fafafc inset;
  -webkit-text-fill-color: var(--ink);
  transition: background-color 9999s ease-out;
}

/* ---------------------------------------------------------
   8. Motion — page entrance animations
   --------------------------------------------------------- */
@keyframes pageFadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes cardRise {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Apply to the main app content wrapper */
.app-home__scroll,
.onboard,
.chat-conv__list,
.subpage__scroll {
  animation: pageFadeIn 320ms ease both;
}

/* Stagger section cards */
.likes__grid > *,
.interest__grid > *,
.discover__people > *,
.near-you > *,
.make-friends > * {
  animation: cardRise 400ms ease both;
}
.likes__grid > *:nth-child(1)  { animation-delay: 20ms; }
.likes__grid > *:nth-child(2)  { animation-delay: 60ms; }
.likes__grid > *:nth-child(3)  { animation-delay: 100ms; }
.likes__grid > *:nth-child(4)  { animation-delay: 140ms; }
.likes__grid > *:nth-child(5)  { animation-delay: 180ms; }
.likes__grid > *:nth-child(6)  { animation-delay: 220ms; }

.interest__grid > *:nth-child(1) { animation-delay: 30ms; }
.interest__grid > *:nth-child(2) { animation-delay: 60ms; }
.interest__grid > *:nth-child(3) { animation-delay: 90ms; }
.interest__grid > *:nth-child(4) { animation-delay: 120ms; }
.interest__grid > *:nth-child(5) { animation-delay: 150ms; }
.interest__grid > *:nth-child(6) { animation-delay: 180ms; }

/* ---------------------------------------------------------
   9. Micro-interactions — lift on hover (desktop only)
   --------------------------------------------------------- */
@media (hover: hover) and (pointer: fine) {
  .interest-card:hover,
  .like-card:hover,
  .chat__item:hover,
  .discover__person:hover {
    transform: translateY(-3px);
  }

  .btn--primary:hover,
  .swipe-action:hover,
  .tabbar__fab:hover {
    transform: translateY(-2px);
  }
}

/* Disable hover effects on touch devices (prevents stuck states) */
@media (hover: none) {
  .interest-card:hover,
  .like-card:hover,
  .chat__item:hover,
  .discover__person:hover,
  .btn:hover,
  .btn--primary:hover,
  .swipe-action:hover,
  .tabbar__fab:hover,
  .app-home__icon:hover,
  .poster-card:hover .poster-card__art {
    transform: none !important;
    box-shadow: inherit;
  }
}

/* ---------------------------------------------------------
   10. Contrast boost for muted text
   --------------------------------------------------------- */
:root {
  /* Slightly deeper muted color for better WCAG AA */
  --muted: #5f5f6c;
  --text-dim: #75757f;
}

/* Restore accent muted colors where they matter */
.chat-msg__meta,
.hero__meta,
.poster-card__meta {
  color: var(--text-dim);
}

/* ---------------------------------------------------------
   11. Safe area insets for notched phones
   --------------------------------------------------------- */
.site-header,
.tabbar,
.chat-conv__top,
.chat-conv__input,
.open-app-banner {
  padding-left: env(safe-area-inset-left, 0);
  padding-right: env(safe-area-inset-right, 0);
}

.tabbar,
.chat-conv__input {
  padding-bottom: calc(10px + env(safe-area-inset-bottom, 0));
}

/* ---------------------------------------------------------
   12. Backdrop blur fallback
   --------------------------------------------------------- */
@supports not (backdrop-filter: blur(10px)) {
  .site-header.is-scrolled,
  .admin-topbar,
  .tabbar,
  .user-menu__dropdown,
  .nav-dropdown__panel,
  .mobile-drawer,
  .open-app-banner,
  .chat-conv__top,
  .chat-conv__input {
    background: rgba(17, 17, 20, 0.96);
  }

  .site-header.is-scrolled { background: rgba(255, 255, 255, 0.96); color: var(--ink); }
}

/* ---------------------------------------------------------
   13. Link & focus on dark backgrounds
   --------------------------------------------------------- */
.site-footer a:focus-visible,
.phone-frame a:focus-visible,
.match-page a:focus-visible,
button:focus-visible.on-dark {
  outline-color: #fff;
  box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.25);
}

/* ---------------------------------------------------------
   14. Smooth image fade-in
   --------------------------------------------------------- */
img {
  transition: opacity 240ms ease;
}

img[data-loaded="false"] {
  opacity: 0;
}

/* ---------------------------------------------------------
   15. Inline code & kbd
   --------------------------------------------------------- */
code {
  font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 0.9em;
  background: rgba(0, 0, 0, 0.05);
  padding: 2px 6px;
  border-radius: 4px;
}

/* ---------------------------------------------------------
   16. Horizontal scroll hints (near-you rows)
   --------------------------------------------------------- */
.near-you,
.chat__matches,
.discover__people,
.filter-pills__scroll,
.states-selector {
  scroll-snap-type: x proximity;
  -webkit-overflow-scrolling: touch;
}

.near-you > *,
.chat__matches > *,
.discover__people > * {
  scroll-snap-align: start;
}

/* Hide scrollbar but keep scrollable */
.near-you::-webkit-scrollbar,
.chat__matches::-webkit-scrollbar,
.discover__people::-webkit-scrollbar,
.filter-pills__scroll::-webkit-scrollbar,
.states-selector::-webkit-scrollbar,
.chat-conv__list::-webkit-scrollbar,
.app-home__scroll::-webkit-scrollbar,
.admin-sidebar::-webkit-scrollbar {
  display: none;
}

/* ---------------------------------------------------------
   17. Number tabular in counters/badges
   --------------------------------------------------------- */
.chat__badge,
.admin-sidebar__badge,
.likes__tab-badge,
.chat-msg__time,
.player__time,
.phone__field-value {
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum' 1;
}

/* ---------------------------------------------------------
   18. Skeletons get a pulse on brand color
   --------------------------------------------------------- */
@keyframes skeletonPulse {
  0%, 100% { opacity: 0.55; }
  50%      { opacity: 0.95; }
}

.skeleton-card__photo,
.skeleton-card__line,
.chat-skeleton__avatar,
.chat-skeleton__line {
  animation: shimmer 1.6s ease-in-out infinite, skeletonPulse 1.6s ease-in-out infinite;
}

/* ---------------------------------------------------------
   19. Prevent text scaling problems on orientation change
   --------------------------------------------------------- */
html {
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

/* ---------------------------------------------------------
   20. Print styles
   --------------------------------------------------------- */
@media print {
  .site-header,
  .site-footer,
  .tabbar,
  .open-app-banner,
  .match-page__float,
  button {
    display: none !important;
  }

  body {
    background: #fff !important;
    color: #000 !important;
  }

  a::after {
    content: " (" attr(href) ")";
    font-size: 0.85em;
    color: #555;
  }

  .page, .app-screen, .phone-frame {
    padding: 0 !important;
    background: #fff !important;
  }
}

/* ---------------------------------------------------------
   21. Reduced motion — respects user preference
   --------------------------------------------------------- */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }

  html { scroll-behavior: auto; }

  .app-home__scroll,
  .onboard,
  .chat-conv__list,
  .subpage__scroll,
  .likes__grid > *,
  .interest__grid > *,
  .discover__people > *,
  .near-you > *,
  .make-friends > * {
    animation: none !important;
  }
}

/* ---------------------------------------------------------
   22. High contrast mode (Windows / forced-colors)
   --------------------------------------------------------- */
@media (forced-colors: active) {
  .btn--primary,
  .swipe-action--like,
  .match-page__btn--primary,
  .tabbar__fab,
  .likes__banner-cta,
  .empty-state__action {
    border: 1px solid CanvasText;
  }

  .poster-card__art,
  .like-card__photo,
  .swipe-card__photo {
    forced-color-adjust: none;
  }
}

/* ---------------------------------------------------------
   23. Dark mode hint (optional — respects system preference)
   --------------------------------------------------------- */
@media (prefers-color-scheme: dark) {
  /* Leave brand look intact — Heartly is intentionally light.
     But soften the white a touch on OLED devices. */
  :root {
    --bg: #fdfdfe;
  }
}
