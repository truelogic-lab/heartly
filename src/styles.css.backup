/* =========================================================
   Heartly — Landing page stylesheet
   White + red marketing design. Responsive 320 → 1440.
   ========================================================= */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

/* ---------------------------------------------------------
   Tokens
   --------------------------------------------------------- */
:root {
  --red: #E63946;
  --red-dark: #C42B37;
  --red-soft: #FFE8EA;
  --ink: #111114;
  --ink-2: #3a3a44;
  --muted: #6b6b78;
  --line: #ececf0;
  --bg: #ffffff;
  --bg-soft: #fafafc;
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-xl: 28px;
  --shadow-soft: 0 12px 32px rgba(17, 17, 20, 0.08);
  --shadow-phone: 0 30px 60px rgba(17, 17, 20, 0.18);
  --container: 1200px;
  --font: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
}

/* ---------------------------------------------------------
   Reset
   --------------------------------------------------------- */
*,
*::before,
*::after { box-sizing: border-box; }

html, body, #root { height: 100%; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font);
  font-size: 16px;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

img { display: block; max-width: 100%; }
a { color: inherit; text-decoration: none; }
button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; border-radius: 4px; }

.text-accent { color: var(--red); }

/* ---------------------------------------------------------
   Buttons
   --------------------------------------------------------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 22px;
  border-radius: 999px;
  font-size: 14px;
  font-weight: 700;
  transition: background 160ms ease, transform 160ms ease, box-shadow 160ms ease;
  text-decoration: none;
  border: 0;
  cursor: pointer;
  white-space: nowrap;
}

.btn--primary {
  background: var(--red);
  color: #fff;
  box-shadow: 0 8px 20px rgba(230, 57, 70, 0.25);
}
.btn--primary:hover {
  background: var(--red-dark);
  transform: translateY(-1px);
  box-shadow: 0 12px 26px rgba(230, 57, 70, 0.35);
}

.btn--sm { padding: 10px 18px; font-size: 13px; }

/* ---------------------------------------------------------
   Header
   --------------------------------------------------------- */
.site-header {
  position: sticky;
  top: 0;
  z-index: 40;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: saturate(180%) blur(12px);
  border-bottom: 1px solid var(--line);
}

.site-header__inner {
  max-width: var(--container);
  margin: 0 auto;
  padding: 18px 32px;
  display: flex;
  align-items: center;
  gap: 40px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -0.3px;
  color: var(--ink);
  flex-shrink: 0;
}
.brand__icon { color: var(--red); font-size: 26px; }
.brand--footer { color: #fff; }
.brand--footer .brand__icon { color: #fff; }

.site-nav {
  display: flex;
  gap: 28px;
  flex: 1;
}

.site-nav__link {
  font-size: 14.5px;
  font-weight: 500;
  color: var(--ink-2);
  transition: color 140ms ease;
}
.site-nav__link:hover { color: var(--red); }

.site-header__actions { display: flex; align-items: center; gap: 12px; }

.site-header__burger {
  display: none;
  width: 40px;
  height: 40px;
  border-radius: 10px;
  color: var(--ink);
  align-items: center;
  justify-content: center;
  font-size: 22px;
  border: 1px solid var(--line);
}

/* Mobile menu */
.mobile-menu {
  border-top: 1px solid var(--line);
  background: #fff;
  padding: 12px 20px 20px;
  animation: fadeSlide 180ms ease;
}

.mobile-menu__nav { display: flex; flex-direction: column; gap: 2px; }

.mobile-menu__link {
  padding: 12px 8px;
  font-size: 15.5px;
  font-weight: 500;
  color: var(--ink-2);
  border-bottom: 1px solid var(--line);
}
.mobile-menu__link:hover { color: var(--red); }

.mobile-menu__cta {
  margin-top: 14px;
  align-self: flex-start;
}

@keyframes fadeSlide {
  from { opacity: 0; transform: translateY(-6px); }
  to   { opacity: 1; transform: translateY(0); }
}

@media (max-width: 900px) {
  .site-nav { display: none; }
  .site-header__actions .btn { display: none; }
  .site-header__burger { display: inline-flex; }
  .site-header__inner { padding: 14px 20px; gap: 16px; }
}

/* ---------------------------------------------------------
   Hero
   --------------------------------------------------------- */
.hero {
  position: relative;
  background: #fff;
  padding: 60px 0 0;
  overflow: hidden;
}

.hero__inner {
  max-width: var(--container);
  margin: 0 auto;
  padding: 0 32px 80px;
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 40px;
  align-items: center;
  position: relative;
  z-index: 2;
}

.hero__copy { max-width: 520px; }

.hero__title {
  font-size: clamp(44px, 6vw, 76px);
  line-height: 1.02;
  letter-spacing: -2px;
  font-weight: 900;
  color: var(--ink);
  margin: 0 0 24px;
}

.hero__heart {
  display: inline-block;
  color: var(--red);
  font-size: 0.55em;
  transform: translateY(-6px);
  margin-left: 6px;
}

.hero__lead {
  font-size: 17px;
  color: var(--ink-2);
  max-width: 420px;
  margin: 0 0 32px;
  line-height: 1.6;
}

.hero__store {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 36px;
}

.store-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 18px;
  background: #111;
  color: #fff;
  border-radius: 12px;
  transition: transform 160ms ease, background 160ms ease;
}
.store-btn:hover { transform: translateY(-2px); background: #000; }

.store-btn svg { font-size: 26px; }

.store-btn__text {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}
.store-btn__text small {
  font-size: 10px;
  letter-spacing: 0.4px;
  opacity: 0.8;
  text-transform: uppercase;
}
.store-btn__text strong {
  font-size: 15px;
  font-weight: 700;
}

.hero__social {
  display: flex;
  align-items: center;
  gap: 16px;
}

.hero__avatars {
  display: flex;
}

.hero__avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  overflow: hidden;
  background: #eee;
  border: 2px solid #fff;
  margin-left: -12px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.08);
}
.hero__avatar:first-child { margin-left: 0; }
.hero__avatar img { width: 100%; height: 100%; object-fit: cover; }

.hero__social-copy {
  display: flex;
  flex-direction: column;
  margin: 0;
  line-height: 1.3;
}
.hero__social-copy strong { font-size: 14px; font-weight: 700; }
.hero__social-copy span { font-size: 13px; color: var(--muted); }

.hero__phones {
  position: relative;
  min-height: 560px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero__phone {
  width: 60%;
  max-width: 320px;
  border-radius: 40px;
  overflow: hidden;
  box-shadow: var(--shadow-phone);
  background: #000;
  aspect-ratio: 9 / 19.5;
}

.hero__phone img { width: 100%; height: 100%; object-fit: cover; }

.hero__phone--back {
  position: absolute;
  top: 40px;
  right: 0;
  transform: translateX(20%) rotate(6deg) scale(0.92);
  z-index: 1;
}

.hero__phone--front {
  position: relative;
  z-index: 2;
  transform: rotate(-3deg);
}

.hero__bg-red {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 42%;
  background: var(--red);
  z-index: 0;
  border-top-left-radius: 32px;
  border-top-right-radius: 32px;
}

@media (max-width: 1024px) {
  .hero__inner { grid-template-columns: 1fr; }
  .hero__copy { max-width: 640px; text-align: left; }
  .hero__phones { min-height: 480px; margin-top: 20px; }
  .hero__bg-red { height: 36%; }
}

@media (max-width: 640px) {
  .hero__inner { padding: 0 20px 60px; }
  .hero__title { letter-spacing: -1.5px; }
  .hero__phones { min-height: 380px; }
  .hero__phone { max-width: 240px; border-radius: 32px; }
  .hero__phone--back { top: 20px; transform: translateX(15%) rotate(6deg) scale(0.9); }
  .hero__social { flex-direction: column; align-items: flex-start; gap: 10px; }
  .hero__bg-red { height: 30%; border-radius: 24px 24px 0 0; }
}

/* ---------------------------------------------------------
   Feature strip (red band)
   --------------------------------------------------------- */
.feature-strip {
  background: var(--red);
  color: #fff;
  padding: 56px 32px 64px;
  border-radius: 32px;
  max-width: var(--container);
  margin: 0 auto 80px;
  position: relative;
  z-index: 3;
  box-shadow: 0 30px 60px rgba(230, 57, 70, 0.18);
}

.feature-strip__title {
  font-size: 26px;
  font-weight: 800;
  letter-spacing: -0.5px;
  margin: 0 0 40px;
}

.feature-strip__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
}

.feature-card {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.feature-card__icon {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
}

.feature-card__title {
  font-size: 17px;
  font-weight: 700;
  margin: 0;
  letter-spacing: -0.2px;
}

.feature-card__copy {
  font-size: 14px;
  line-height: 1.55;
  opacity: 0.9;
  margin: 0;
}

@media (max-width: 900px) {
  .feature-strip { padding: 40px 24px 48px; border-radius: 24px; margin-bottom: 60px; }
  .feature-strip__grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .feature-strip__title { font-size: 22px; margin-bottom: 28px; }
}

@media (max-width: 480px) {
  .feature-strip { padding: 32px 20px 40px; border-radius: 20px; margin: 0 16px 48px; }
  .feature-strip__grid { grid-template-columns: 1fr; gap: 22px; }
  .feature-strip__title { font-size: 20px; }
}

/* ---------------------------------------------------------
   Meet singles
   --------------------------------------------------------- */
.meet {
  background: #fff;
  padding: 20px 32px 100px;
}

.meet__inner {
  max-width: var(--container);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 60px;
  align-items: center;
}

.meet__title {
  font-size: clamp(32px, 4vw, 44px);
  font-weight: 900;
  letter-spacing: -1.4px;
  margin: 0 0 14px;
  color: var(--ink);
  line-height: 1.1;
}

.meet__lead {
  font-size: 16px;
  color: var(--ink-2);
  margin: 0 0 36px;
  max-width: 380px;
}

.meet__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.meet__item {
  display: flex;
  gap: 16px;
  align-items: flex-start;
}

.meet__icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: var(--red-soft);
  color: var(--red);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  flex-shrink: 0;
}

.meet__item-title {
  font-size: 16px;
  font-weight: 700;
  margin: 0 0 4px;
  color: var(--ink);
}

.meet__item-copy {
  font-size: 14px;
  color: var(--muted);
  margin: 0;
  max-width: 300px;
}

.meet__phones {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  align-items: end;
}

.meet__phone {
  border-radius: 32px;
  overflow: hidden;
  background: #000;
  aspect-ratio: 9 / 19.5;
  box-shadow: var(--shadow-phone);
}
.meet__phone img { width: 100%; height: 100%; object-fit: cover; }

.meet__phone--mid { transform: translateY(-30px); }

@media (max-width: 1024px) {
  .meet__inner { grid-template-columns: 1fr; gap: 40px; }
  .meet__lead { max-width: none; }
  .meet__item-copy { max-width: none; }
}

@media (max-width: 640px) {
  .meet { padding: 0 20px 60px; }
  .meet__phones { gap: 12px; }
  .meet__phone { border-radius: 22px; }
  .meet__phone--mid { transform: translateY(-16px); }
  .meet__title { letter-spacing: -1px; }
}

@media (max-width: 400px) {
  .meet__phones { grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .meet__phone { border-radius: 16px; }
}

/* ---------------------------------------------------------
   Safety
   --------------------------------------------------------- */
.safety {
  background: var(--bg-soft);
  padding: 80px 32px;
}

.safety__inner {
  max-width: var(--container);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 2.2fr;
  gap: 60px;
  align-items: start;
}

.safety__icon {
  width: 56px;
  height: 56px;
  border-radius: 16px;
  background: var(--red);
  color: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  margin-bottom: 20px;
}

.safety__title {
  font-size: clamp(26px, 3vw, 34px);
  font-weight: 900;
  letter-spacing: -1px;
  margin: 0 0 14px;
  color: var(--ink);
  line-height: 1.15;
}

.safety__copy {
  font-size: 15px;
  color: var(--ink-2);
  margin: 0;
  line-height: 1.6;
  max-width: 340px;
}

.safety__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.safety__item {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.safety__item-icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #fff;
  color: var(--red);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  box-shadow: var(--shadow-soft);
}

.safety__item-title {
  font-size: 15px;
  font-weight: 700;
  margin: 0;
  color: var(--ink);
}

.safety__item-copy {
  font-size: 13.5px;
  color: var(--muted);
  margin: 0;
  line-height: 1.55;
}

@media (max-width: 1024px) {
  .safety__inner { grid-template-columns: 1fr; gap: 40px; }
  .safety__grid { grid-template-columns: repeat(2, 1fr); gap: 28px; }
  .safety__copy { max-width: none; }
}

@media (max-width: 640px) {
  .safety { padding: 60px 20px; }
  .safety__grid { grid-template-columns: 1fr; gap: 22px; }
}

/* ---------------------------------------------------------
   Footer
   --------------------------------------------------------- */
.site-footer {
  background: var(--red);
  color: #fff;
  padding: 32px;
}

.site-footer__inner {
  max-width: var(--container);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}

.site-footer__left {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.site-footer__copy { font-size: 12.5px; opacity: 0.85; margin: 0; }

.site-footer__tag {
  font-size: 13.5px;
  margin: 0;
  opacity: 0.95;
  text-align: center;
  flex: 1;
}

.site-footer__social {
  display: flex;
  gap: 14px;
}

.site-footer__social a {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  transition: background 140ms ease, transform 140ms ease;
}
.site-footer__social a:hover {
  background: rgba(255, 255, 255, 0.3);
  transform: translateY(-2px);
}

@media (max-width: 640px) {
  .site-footer { padding: 28px 20px; }
  .site-footer__inner { flex-direction: column; align-items: flex-start; gap: 18px; }
  .site-footer__tag { text-align: left; }
}

/* =========================================================
   RESPONSIVE ENHANCEMENT LAYER
   Appended. Does not modify any rule above.
   Adds breakpoints: 1440, 1200, 1024, 900, 768, 640, 480, 360
   ========================================================= */

/* ---------------------------------------------------------
   1440px — Large desktop — cap widths, breathe
   --------------------------------------------------------- */
@media (max-width: 1440px) {
  .site-header__inner,
  .hero__inner,
  .meet__inner,
  .safety__inner,
  .site-footer__inner { padding-left: 28px; padding-right: 28px; }
}

/* ---------------------------------------------------------
   1200px — Small desktop / large laptop
   --------------------------------------------------------- */
@media (max-width: 1200px) {
  .site-header__inner { padding: 16px 24px; gap: 24px; }
  .site-nav { gap: 20px; }
  .site-nav__link { font-size: 14px; }

  .hero__inner { padding: 0 24px 60px; gap: 32px; }
  .hero__title { letter-spacing: -1.6px; }
  .hero__phone { max-width: 280px; }
  .hero__phone--back { top: 30px; }

  .feature-strip { padding: 48px 28px 56px; border-radius: 28px; }
  .feature-strip__grid { gap: 24px; }

  .meet__inner { gap: 40px; }
  .meet__phone { border-radius: 26px; }

  .safety__inner { gap: 40px; }
}

/* ---------------------------------------------------------
   1024px — Tablet landscape
   --------------------------------------------------------- */
@media (max-width: 1024px) {
  /* Header */
  .site-header__inner { padding: 16px 24px; }
  .site-nav { gap: 18px; }
  .site-nav__link { font-size: 13.5px; }

  /* Hero */
  .hero { padding-top: 40px; }
  .hero__inner {
    padding: 0 24px 60px;
    gap: 30px;
  }
  .hero__title { font-size: clamp(40px, 6.5vw, 64px); letter-spacing: -1.6px; }
  .hero__lead { font-size: 16px; }
  .hero__phones { min-height: 480px; }
  .hero__phone { max-width: 260px; border-radius: 34px; }
  .hero__phone--back { top: 24px; transform: translateX(18%) rotate(6deg) scale(0.9); }
  .hero__bg-red { height: 38%; }

  /* Feature strip */
  .feature-strip {
    padding: 44px 24px 52px;
    border-radius: 26px;
    margin: 0 20px 64px;
  }
  .feature-strip__title { font-size: 24px; margin-bottom: 32px; }
  .feature-strip__grid { gap: 22px; }
  .feature-card__title { font-size: 16px; }
  .feature-card__copy { font-size: 13.5px; }

  /* Meet */
  .meet { padding: 20px 24px 80px; }
  .meet__inner { gap: 32px; }
  .meet__title { font-size: clamp(28px, 4.5vw, 38px); }
  .meet__lead { font-size: 15px; }
  .meet__phones { gap: 16px; }
  .meet__phone { border-radius: 24px; }
  .meet__phone--mid { transform: translateY(-22px); }

  /* Safety */
  .safety { padding: 64px 24px; }
  .safety__inner { gap: 32px; }
  .safety__grid { gap: 20px; }
  .safety__item-copy { font-size: 13px; }

  /* Footer */
  .site-footer { padding: 28px 24px; }
}

/* ---------------------------------------------------------
   900px — Tablet portrait
   --------------------------------------------------------- */
@media (max-width: 900px) {
  /* Header collapse */
  .site-header__inner { padding: 14px 20px; gap: 16px; }
  .site-nav { display: none; }
  .site-header__actions .btn { display: none; }
  .site-header__burger { display: inline-flex; }
  .brand { font-size: 20px; }

  /* Hero */
  .hero { padding-top: 32px; }
  .hero__inner {
    padding: 0 20px 60px;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .hero__copy { max-width: 640px; }
  .hero__title { font-size: clamp(38px, 8vw, 56px); letter-spacing: -1.4px; }
  .hero__lead { font-size: 16px; max-width: 100%; margin-bottom: 26px; }
  .hero__store { gap: 10px; margin-bottom: 28px; }
  .store-btn { padding: 9px 16px; }
  .store-btn svg { font-size: 22px; }
  .store-btn__text strong { font-size: 14px; }

  .hero__phones { min-height: 420px; margin-top: 12px; }
  .hero__phone { max-width: 230px; border-radius: 30px; }
  .hero__phone--back { top: 20px; }

  /* Feature strip */
  .feature-strip {
    padding: 40px 22px 46px;
    border-radius: 24px;
    margin: 0 16px 56px;
  }
  .feature-strip__title { font-size: 22px; margin-bottom: 26px; }
  .feature-strip__grid { grid-template-columns: repeat(2, 1fr); gap: 22px; }
  .feature-card__icon { width: 42px; height: 42px; font-size: 20px; }

  /* Meet */
  .meet { padding: 10px 20px 70px; }
  .meet__inner { grid-template-columns: 1fr; gap: 30px; }
  .meet__title { font-size: clamp(26px, 6vw, 34px); }
  .meet__lead { max-width: 100%; margin-bottom: 28px; }
  .meet__item-copy { max-width: 100%; }
  .meet__phones { gap: 14px; }
  .meet__phone { border-radius: 22px; }
  .meet__phone--mid { transform: translateY(-18px); }

  /* Safety */
  .safety { padding: 56px 20px; }
  .safety__inner { grid-template-columns: 1fr; gap: 30px; }
  .safety__copy { max-width: 100%; }
  .safety__grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }

  /* Footer */
  .site-footer { padding: 26px 20px; }
  .site-footer__tag { text-align: left; flex: 1 1 100%; }
}

/* ---------------------------------------------------------
   768px — Large phone / small tablet
   --------------------------------------------------------- */
@media (max-width: 768px) {
  /* Hero */
  .hero__inner { padding: 0 18px 50px; gap: 28px; }
  .hero__title { font-size: clamp(34px, 8.5vw, 48px); letter-spacing: -1.2px; }
  .hero__heart { font-size: 0.5em; transform: translateY(-4px); margin-left: 4px; }
  .hero__lead { font-size: 15.5px; line-height: 1.55; margin-bottom: 24px; }
  .hero__store { flex-direction: column; align-items: stretch; gap: 10px; }
  .store-btn { justify-content: center; padding: 11px 18px; }
  .hero__social { gap: 12px; }
  .hero__avatar { width: 36px; height: 36px; }
  .hero__social-copy strong { font-size: 13.5px; }
  .hero__social-copy span { font-size: 12.5px; }

  .hero__phones { min-height: 360px; }
  .hero__phone { max-width: 200px; border-radius: 26px; }
  .hero__phone--back { top: 12px; transform: translateX(14%) rotate(6deg) scale(0.9); }
  .hero__bg-red { height: 32%; border-radius: 20px 20px 0 0; }

  /* Feature strip */
  .feature-strip {
    padding: 34px 20px 40px;
    border-radius: 20px;
    margin: 0 12px 48px;
  }
  .feature-strip__title { font-size: 20px; margin-bottom: 24px; }
  .feature-strip__grid { grid-template-columns: 1fr; gap: 22px; }
  .feature-card__icon { width: 40px; height: 40px; font-size: 19px; }
  .feature-card__title { font-size: 15.5px; }
  .feature-card__copy { font-size: 13.5px; }

  /* Meet */
  .meet { padding: 0 18px 60px; }
  .meet__inner { gap: 26px; }
  .meet__title { font-size: clamp(24px, 7vw, 30px); letter-spacing: -0.9px; }
  .meet__lead { font-size: 14.5px; margin-bottom: 24px; }
  .meet__list { gap: 20px; }
  .meet__icon { width: 40px; height: 40px; font-size: 20px; border-radius: 10px; }
  .meet__item-title { font-size: 15px; }
  .meet__item-copy { font-size: 13.5px; }
  .meet__phones { gap: 12px; }
  .meet__phone { border-radius: 18px; }
  .meet__phone--mid { transform: translateY(-14px); }

  /* Safety */
  .safety { padding: 48px 18px; }
  .safety__icon { width: 48px; height: 48px; font-size: 24px; border-radius: 12px; }
  .safety__title { font-size: clamp(22px, 6vw, 28px); }
  .safety__copy { font-size: 14.5px; }
  .safety__grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .safety__item-icon { width: 40px; height: 40px; font-size: 20px; }
  .safety__item-title { font-size: 14.5px; }
  .safety__item-copy { font-size: 13px; }

  /* Footer */
  .site-footer { padding: 24px 18px; }
  .site-footer__social a { width: 34px; height: 34px; font-size: 14px; }
}

/* ---------------------------------------------------------
   640px — Standard phone
   --------------------------------------------------------- */
@media (max-width: 640px) {
  /* Header */
  .site-header__inner { padding: 12px 16px; }
  .brand { font-size: 19px; gap: 6px; }
  .brand__icon { font-size: 22px; }
  .site-header__burger { width: 38px; height: 38px; font-size: 20px; }
  .mobile-menu { padding: 10px 16px 18px; }
  .mobile-menu__link { font-size: 15px; padding: 11px 6px; }
  .mobile-menu__cta { width: 100%; }

  /* Hero */
  .hero { padding-top: 24px; }
  .hero__inner { padding: 0 16px 44px; gap: 24px; }
  .hero__title { font-size: clamp(30px, 9vw, 42px); letter-spacing: -1px; }
  .hero__lead { font-size: 15px; margin-bottom: 20px; }
  .hero__store { margin-bottom: 22px; }
  .store-btn { padding: 10px 16px; gap: 8px; border-radius: 10px; }
  .store-btn svg { font-size: 20px; }
  .store-btn__text small { font-size: 9px; }
  .store-btn__text strong { font-size: 13.5px; }

  .hero__social { flex-direction: column; align-items: flex-start; gap: 10px; }
  .hero__avatars { flex-wrap: wrap; }
  .hero__avatar { width: 34px; height: 34px; }

  .hero__phones { min-height: 320px; }
  .hero__phone { max-width: 175px; border-radius: 22px; }
  .hero__phone--back { top: 8px; transform: translateX(12%) rotate(6deg) scale(0.9); }
  .hero__bg-red { height: 28%; border-radius: 16px 16px 0 0; }

  /* Feature strip */
  .feature-strip {
    padding: 30px 18px 36px;
    border-radius: 18px;
    margin: 0 10px 40px;
  }
  .feature-strip__title { font-size: 19px; margin-bottom: 22px; }
  .feature-strip__grid { gap: 20px; }
  .feature-card__icon { width: 38px; height: 38px; font-size: 18px; }
  .feature-card__title { font-size: 15px; }
  .feature-card__copy { font-size: 13px; line-height: 1.5; }

  /* Meet */
  .meet { padding: 0 16px 52px; }
  .meet__title { font-size: clamp(22px, 7.5vw, 28px); margin-bottom: 12px; }
  .meet__lead { font-size: 14px; margin-bottom: 22px; }
  .meet__list { gap: 18px; }
  .meet__item { gap: 14px; }
  .meet__icon { width: 38px; height: 38px; font-size: 19px; }
  .meet__item-title { font-size: 14.5px; }
  .meet__item-copy { font-size: 13px; }
  .meet__phones { gap: 10px; }
  .meet__phone { border-radius: 16px; }
  .meet__phone--mid { transform: translateY(-12px); }

  /* Safety */
  .safety { padding: 42px 16px; }
  .safety__icon { width: 44px; height: 44px; font-size: 22px; margin-bottom: 16px; }
  .safety__title { font-size: clamp(20px, 6.5vw, 26px); margin-bottom: 10px; }
  .safety__copy { font-size: 14px; }
  .safety__grid { grid-template-columns: 1fr; gap: 18px; }
  .safety__item { gap: 10px; }
  .safety__item-icon { width: 38px; height: 38px; font-size: 18px; }
  .safety__item-title { font-size: 14px; }
  .safety__item-copy { font-size: 12.5px; }

  /* Footer */
  .site-footer { padding: 22px 16px; }
  .site-footer__inner { gap: 16px; }
  .site-footer__tag { font-size: 13px; }
  .site-footer__copy { font-size: 12px; }
  .site-footer__social { gap: 10px; }
  .site-footer__social a { width: 32px; height: 32px; font-size: 13px; }
}

/* ---------------------------------------------------------
   480px — Small phone
   --------------------------------------------------------- */
@media (max-width: 480px) {
  .site-header__inner { padding: 12px 14px; }
  .brand { font-size: 18px; }
  .brand__icon { font-size: 20px; }

  .hero__inner { padding: 0 14px 40px; }
  .hero__title { font-size: clamp(28px, 10vw, 36px); letter-spacing: -0.8px; }
  .hero__lead { font-size: 14.5px; line-height: 1.5; }
  .hero__heart { font-size: 0.45em; }

  .store-btn { padding: 9px 14px; }
  .store-btn__text strong { font-size: 13px; }
  .store-btn__text small { font-size: 8.5px; letter-spacing: 0.3px; }

  .hero__social-copy strong { font-size: 13px; }
  .hero__social-copy span { font-size: 12px; }
  .hero__avatar { width: 32px; height: 32px; margin-left: -10px; }

  .hero__phones { min-height: 290px; }
  .hero__phone { max-width: 155px; border-radius: 20px; }

  .feature-strip {
    padding: 26px 16px 32px;
    border-radius: 16px;
    margin: 0 8px 36px;
  }
  .feature-strip__title { font-size: 18px; margin-bottom: 20px; }
  .feature-card__icon { width: 36px; height: 36px; font-size: 17px; }
  .feature-card__title { font-size: 14.5px; }

  .meet { padding: 0 14px 46px; }
  .meet__title { font-size: clamp(20px, 7.5vw, 26px); }
  .meet__icon { width: 36px; height: 36px; font-size: 18px; border-radius: 9px; }

  .meet__phones { gap: 8px; }
  .meet__phone { border-radius: 14px; }
  .meet__phone--mid { transform: translateY(-10px); }

  .safety { padding: 36px 14px; }
  .safety__title { font-size: clamp(19px, 6.5vw, 24px); }
  .safety__item-icon { width: 36px; height: 36px; font-size: 17px; }

  .site-footer { padding: 20px 14px; }
  .site-footer__social a { width: 30px; height: 30px; font-size: 12px; }
}

/* ---------------------------------------------------------
   360px — Very small phone (iPhone SE, older Androids)
   --------------------------------------------------------- */
@media (max-width: 360px) {
  .site-header__inner { padding: 10px 12px; }
  .brand { font-size: 17px; }
  .site-header__burger { width: 34px; height: 34px; font-size: 18px; }

  .hero__inner { padding: 0 12px 36px; }
  .hero__title { font-size: clamp(24px, 9vw, 32px); letter-spacing: -0.6px; }
  .hero__lead { font-size: 14px; }
  .hero__store { gap: 8px; }
  .store-btn { padding: 9px 12px; }
  .store-btn svg { font-size: 18px; }
  .store-btn__text strong { font-size: 12.5px; }

  .hero__phones { min-height: 260px; }
  .hero__phone { max-width: 130px; border-radius: 18px; }
  .hero__phone--back { top: 6px; }

  .feature-strip {
    padding: 22px 14px 28px;
    margin: 0 6px 32px;
  }
  .feature-strip__title { font-size: 17px; }
  .feature-card__title { font-size: 14px; }
  .feature-card__copy { font-size: 12.5px; }

  .meet { padding: 0 12px 40px; }
  .meet__item-copy { font-size: 12.5px; }

  .safety { padding: 32px 12px; }
  .safety__item-copy { font-size: 12px; }

  .site-footer { padding: 18px 12px; }
  .site-footer__social a { width: 28px; height: 28px; font-size: 11px; }
}

/* ---------------------------------------------------------
   Landscape phones (short viewport)
   --------------------------------------------------------- */
@media (max-height: 500px) and (orientation: landscape) {
  .hero { padding-top: 20px; }
  .hero__inner { padding-bottom: 40px; gap: 20px; }
  .hero__phones { min-height: 320px; }
  .hero__phone { max-width: 180px; }
  .site-header__inner { padding: 10px 20px; }
}

/* ---------------------------------------------------------
   Touch devices — larger tap targets
   --------------------------------------------------------- */
@media (hover: none) and (pointer: coarse) {
  .site-nav__link,
  .mobile-menu__link {
    padding-top: 12px;
    padding-bottom: 12px;
  }
  .store-btn { min-height: 48px; }
  .btn { min-height: 44px; }
}

/* ---------------------------------------------------------
   Reduced motion
   --------------------------------------------------------- */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    transition: none !important;
    animation: none !important;
  }
}

/* =========================================================
   MOBILE POLISH — round 2
   Fixes hero phone cropping, red-band alignment, and
   provides graceful empty-image placeholders.
   ========================================================= */

/* ---------------------------------------------------------
   Empty / broken image handling
   Shows a soft gradient placeholder instead of broken icon
   --------------------------------------------------------- */
.hero__avatar,
.hero__phone,
.meet__phone {
  background: linear-gradient(135deg, #f2f2f6 0%, #e6e6ee 100%);
  position: relative;
  overflow: hidden;
}

.hero__avatar img,
.hero__phone img,
.meet__phone img {
  background: linear-gradient(135deg, #efeef3 0%, #e2e1e9 100%);
  min-height: 100%;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ---------------------------------------------------------
   Hero — desktop / tablet: keep phones in frame
   --------------------------------------------------------- */
.hero__phones {
  position: relative;
  min-height: 560px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.hero__phone {
  width: 60%;
  max-width: 320px;
  aspect-ratio: 9 / 19.5;
  border-radius: 40px;
  overflow: hidden;
  box-shadow: var(--shadow-phone);
  background: #000;
}

/* ---------------------------------------------------------
   Hero — tablet (<= 900px): stack phones, keep whole
   --------------------------------------------------------- */
@media (max-width: 900px) {
  .hero__phones {
    min-height: auto;
    padding: 20px 0 0;
    align-items: center;
    justify-content: center;
  }

  .hero__phone {
    width: auto;
    max-width: none;
    height: auto;
    aspect-ratio: 9 / 19.5;
    flex: 0 0 auto;
  }

  .hero__phone--back {
    position: absolute;
    top: 10px;
    right: 0;
    transform: translateX(15%) rotate(6deg) scale(0.92);
    width: 200px;
    height: auto;
  }

  .hero__phone--front {
    position: relative;
    width: 220px;
    height: auto;
    transform: rotate(-3deg);
  }

  .hero__bg-red {
    height: 34%;
    border-radius: 24px 24px 0 0;
  }
}

/* ---------------------------------------------------------
   Hero — phone (<= 640px): tighter phones, no clipping
   --------------------------------------------------------- */
@media (max-width: 640px) {
  .hero {
    padding-top: 20px;
  }

  .hero__inner {
    padding: 0 16px 60px;
    gap: 28px;
  }

  .hero__phones {
    min-height: auto;
    padding: 8px 0 20px;
  }

  .hero__phone--back {
    position: absolute;
    top: 6px;
    right: 8%;
    width: 150px;
    transform: rotate(6deg);
    z-index: 1;
    opacity: 0.95;
  }

  .hero__phone--front {
    width: 170px;
    transform: rotate(-3deg);
    z-index: 2;
  }

  .hero__bg-red {
    height: 30%;
    border-radius: 18px 18px 0 0;
  }
}

/* ---------------------------------------------------------
   Hero — small phone (<= 480px): side-by-side, compact
   --------------------------------------------------------- */
@media (max-width: 480px) {
  .hero__inner {
    padding: 0 14px 56px;
    gap: 24px;
  }

  .hero__phones {
    min-height: 320px;
    padding: 6px 0 12px;
  }

  .hero__phone--back {
    top: 4px;
    right: 4%;
    width: 130px;
  }

  .hero__phone--front {
    width: 150px;
  }

  .hero__bg-red {
    height: 26%;
    border-radius: 16px 16px 0 0;
  }
}

/* ---------------------------------------------------------
   Hero — very small (<= 360px)
   --------------------------------------------------------- */
@media (max-width: 360px) {
  .hero__phones { min-height: 280px; }
  .hero__phone--back { width: 115px; right: 3%; }
  .hero__phone--front { width: 135px; }
}

/* ---------------------------------------------------------
   Feature strip — full-width bleed on mobile so it doesn't
   look like a floating card hugging the edges
   --------------------------------------------------------- */
@media (max-width: 640px) {
  .feature-strip {
    border-radius: 20px;
    margin: 0 12px 44px;
    padding: 32px 20px 40px;
  }
}

@media (max-width: 480px) {
  .feature-strip {
    border-radius: 16px;
    margin: 0 10px 40px;
    padding: 28px 18px 34px;
  }
}

@media (max-width: 360px) {
  .feature-strip {
    border-radius: 14px;
    margin: 0 8px 36px;
    padding: 24px 16px 30px;
  }
}

/* ---------------------------------------------------------
   Meet singles — phone row stays side-by-side, never crops
   --------------------------------------------------------- */
@media (max-width: 640px) {
  .meet__phones {
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    align-items: center;
  }

  .meet__phone {
    width: 100%;
    aspect-ratio: 9 / 19.5;
    border-radius: 16px;
  }

  .meet__phone--mid {
    transform: translateY(-14px);
  }
}

@media (max-width: 480px) {
  .meet__phones { gap: 8px; }
  .meet__phone { border-radius: 14px; }
  .meet__phone--mid { transform: translateY(-10px); }
}

@media (max-width: 360px) {
  .meet__phones { gap: 6px; }
  .meet__phone { border-radius: 12px; }
  .meet__phone--mid { transform: translateY(-8px); }
}

/* ---------------------------------------------------------
   Footer — social icons wrap on very small phones
   --------------------------------------------------------- */
@media (max-width: 360px) {
  .site-footer__social {
    flex-wrap: wrap;
    gap: 8px;
  }
}

/* ---------------------------------------------------------
   Prevent horizontal scroll — blanket safety net
   --------------------------------------------------------- */
html, body {
  overflow-x: hidden;
  max-width: 100vw;
}

* {
  min-width: 0;
}

/* =========================================================
   HEADER FIX — hamburger to the far right corner
   ========================================================= */

/* Base: push actions group to the right, burger to the very end */
.site-header__actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 12px;
}

/* On desktop, nav takes the flex space; keep as is */
@media (min-width: 901px) {
  .site-header__actions { margin-left: 0; }
}

/* Mobile / tablet — nav hidden, push button to right edge */
@media (max-width: 900px) {
  .site-header__inner {
    justify-content: space-between;
    gap: 12px;
  }

  .site-nav { display: none; }

  .site-header__actions {
    margin-left: auto;
    gap: 8px;
  }

  .site-header__burger {
    margin-left: auto;
    order: 2;
  }

  .site-header__actions .btn { display: none; }

  /* If the CTA button is visible at some widths, keep burger last */
  .site-header__actions .btn { order: 1; }
}

/* Phone widths — burger sits flush right with a little padding */
@media (max-width: 640px) {
  .site-header__inner {
    padding: 12px 16px;
    justify-content: space-between;
  }
  .site-header__burger {
    width: 40px;
    height: 40px;
    margin-left: auto;
  }
}

@media (max-width: 480px) {
  .site-header__inner { padding: 12px 14px; }
  .site-header__burger { width: 38px; height: 38px; font-size: 20px; }
}

@media (max-width: 360px) {
  .site-header__inner { padding: 10px 12px; }
  .site-header__burger { width: 36px; height: 36px; font-size: 18px; }
}

/* =========================================================
   Avatar with initials fallback
   ========================================================= */
.hero__avatar {
  position: relative;
  background: linear-gradient(135deg, #E63946, #C42B37);
  color: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 12px;
  letter-spacing: 0.5px;
}

.hero__avatar::before {
  content: attr(data-initials);
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  z-index: 1;
}

.hero__avatar img {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
  display: block;
}

/* =========================================================
   IMAGE-FIT LAYER
   Stops phone images from being cropped/stretched.
   Images flow at their natural aspect ratio.
   ========================================================= */

/* ---------- HERO PHONES ---------- */

/* Base: remove forced aspect ratio, let image decide height */
.hero__phones {
  position: relative;
  min-height: 520px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.hero__phone {
  width: auto;
  max-width: none;
  aspect-ratio: auto;      /* ⬅ was forcing 9:19.5 */
  height: auto;            /* ⬅ let image set the height */
  border-radius: 0;        /* ⬅ remove — images already have rounded frames */
  overflow: visible;       /* ⬅ don't clip baked-in frames */
  background: transparent; /* ⬅ remove black backing */
  box-shadow: none;        /* ⬅ images already have their own shadow */
}

.hero__phone img {
  width: 100%;
  height: auto;            /* ⬅ natural ratio */
  display: block;
  object-fit: contain;     /* ⬅ NEVER crop — always show full image */
}

/* Front phone (Sophie) */
.hero__phone--front {
  position: relative;
  width: 260px;
  max-width: 42%;
  z-index: 2;
  transform: rotate(-2deg);
  transform-origin: center;
}

/* Back phone (It's a Match) */
.hero__phone--back {
  position: absolute;
  top: 40px;
  right: 0;
  width: 230px;
  max-width: 38%;
  z-index: 1;
  transform: translateX(15%) rotate(6deg);
  transform-origin: center;
}

/* ---------- HERO RED BAND — align with phone bottom ---------- */

.hero__bg-red {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 46%;              /* aligns to where phones sit */
  background: var(--red);
  border-top-left-radius: 32px;
  border-top-right-radius: 32px;
  z-index: 0;
  pointer-events: none;
}

/* Make sure copy content sits ABOVE the red band */
.hero__copy { position: relative; z-index: 5; }

/* ---------- MEET SINGLES PHONES ---------- */

.meet__phones {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  align-items: center;      /* center all, remove the -30px lift */
}

.meet__phone {
  width: 100%;
  aspect-ratio: auto;       /* ⬅ was 9:19.5 */
  height: auto;
  border-radius: 0;
  overflow: visible;
  background: transparent;
  box-shadow: none;
  transform: none;          /* ⬅ remove the -30px lift that causes overlap */
}

.meet__phone--mid {
  transform: none;          /* ⬅ no more lift */
}

.meet__phone img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: contain;
}

/* =========================================================
   RESPONSIVE — image-fit layer
   ========================================================= */

/* ---------- 1024px ---------- */
@media (max-width: 1024px) {
  .hero__phones { min-height: 460px; }
  .hero__phone--front { width: 230px; max-width: 44%; }
  .hero__phone--back  { width: 205px; max-width: 40%; top: 34px; }
  .hero__bg-red { height: 44%; }
}

/* ---------- 900px (hero stacks) ---------- */
@media (max-width: 900px) {
  .hero__inner { grid-template-columns: 1fr; }
  .hero__phones {
    min-height: 420px;
    padding: 20px 0 0;
  }
  .hero__phone--front { width: 240px; max-width: 55%; }
  .hero__phone--back  { width: 210px; max-width: 50%; top: 20px; right: 4%; }
  .hero__bg-red { height: 40%; border-radius: 24px 24px 0 0; }
}

/* ---------- 768px ---------- */
@media (max-width: 768px) {
  .hero__phones { min-height: 380px; }
  .hero__phone--front { width: 210px; max-width: 58%; }
  .hero__phone--back  { width: 185px; max-width: 52%; top: 14px; right: 3%; }
  .hero__bg-red { height: 36%; border-radius: 20px 20px 0 0; }

  .meet__phones { gap: 12px; }
}

/* ---------- 640px ---------- */
@media (max-width: 640px) {
  .hero__inner { padding: 0 16px 60px; gap: 28px; }
  .hero__phones { min-height: 340px; padding: 10px 0 0; }
  .hero__phone--front { width: 180px; max-width: 60%; }
  .hero__phone--back  { width: 160px; max-width: 54%; top: 10px; right: 2%; }
  .hero__bg-red { height: 32%; border-radius: 18px 18px 0 0; }

  .meet { padding: 0 16px 52px; }
  .meet__phones { gap: 10px; }
}

/* ---------- 480px ---------- */
@media (max-width: 480px) {
  .hero__inner { padding: 0 14px 56px; gap: 24px; }
  .hero__phones { min-height: 300px; }
  .hero__phone--front { width: 155px; max-width: 62%; }
  .hero__phone--back  { width: 140px; max-width: 56%; top: 8px; right: 2%; }
  .hero__bg-red { height: 28%; border-radius: 16px 16px 0 0; }

  .meet__phones { gap: 8px; }
}

/* ---------- 360px ---------- */
@media (max-width: 360px) {
  .hero__phones { min-height: 270px; }
  .hero__phone--front { width: 135px; }
  .hero__phone--back  { width: 120px; top: 6px; }
  .hero__bg-red { height: 26%; }

  .meet__phones { gap: 6px; }
}

/* =========================================================
   IMAGES-ONLY LAYER
   Strips all backgrounds, shadows, borders, radii, and
   aspect-ratio constraints from phone containers so the
   raw PNG is the only thing visible.
   ========================================================= */

/* ---- Hero phones ---- */
.hero__phones {
  background: transparent !important;
  box-shadow: none !important;
  border: 0 !important;
}

.hero__phone,
.hero__phone--front,
.hero__phone--back {
  background: transparent !important;
  box-shadow: none !important;
  border: 0 !important;
  border-radius: 0 !important;
  overflow: visible !important;
  aspect-ratio: auto !important;
  height: auto !important;
  width: auto !important;
}

.hero__phone img,
.hero__phone--front img,
.hero__phone--back img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
  border-radius: 0;
  box-shadow: none;
  background: transparent;
}

/* Explicit widths (only dimensions — no styling) */
.hero__phone--front { width: 260px !important; max-width: 42% !important; }
.hero__phone--back  { width: 230px !important; max-width: 38% !important; }

/* ---- Meet-singles phones ---- */
.meet__phones {
  background: transparent !important;
  box-shadow: none !important;
  border: 0 !important;
}

.meet__phone,
.meet__phone--mid {
  background: transparent !important;
  box-shadow: none !important;
  border: 0 !important;
  border-radius: 0 !important;
  overflow: visible !important;
  aspect-ratio: auto !important;
  height: auto !important;
  transform: none !important;
}

.meet__phone img,
.meet__phone--mid img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
  border-radius: 0;
  box-shadow: none;
  background: transparent;
}

/* ---- Kill gradient placeholders from earlier fix ---- */
.hero__avatar,
.hero__phone,
.meet__phone {
  background: transparent !important;
}

.hero__avatar img,
.hero__phone img,
.meet__phone img {
  background: transparent !important;
}

/* ---- Red band stays as the section backdrop ---- */
.hero__bg-red {
  /* keep as-is */
}

/* ---- Responsive: only widths, no styling ---- */
@media (max-width: 1024px) {
  .hero__phone--front { width: 230px !important; max-width: 44% !important; }
  .hero__phone--back  { width: 205px !important; max-width: 40% !important; }
}

@media (max-width: 900px) {
  .hero__phone--front { width: 240px !important; max-width: 55% !important; }
  .hero__phone--back  { width: 210px !important; max-width: 50% !important; }
}

@media (max-width: 768px) {
  .hero__phone--front { width: 210px !important; max-width: 58% !important; }
  .hero__phone--back  { width: 185px !important; max-width: 52% !important; }
}

@media (max-width: 640px) {
  .hero__phone--front { width: 180px !important; max-width: 60% !important; }
  .hero__phone--back  { width: 160px !important; max-width: 54% !important; }
}

@media (max-width: 480px) {
  .hero__phone--front { width: 155px !important; max-width: 62% !important; }
  .hero__phone--back  { width: 140px !important; max-width: 56% !important; }
}

@media (max-width: 360px) {
  .hero__phone--front { width: 135px !important; }
  .hero__phone--back  { width: 120px !important; }
}

/* =========================================================
   HERO POLISH ROUND 3
   - Desktop: tighter red band, phones properly composed
   - Mobile: bigger phone images
   ========================================================= */

/* ---------- DESKTOP (>= 1025px) ---------- */

@media (min-width: 1025px) {
  /* Reduce the empty red band — align it to the phone base */
  .hero__bg-red {
    height: 38% !important;
    border-radius: 32px 32px 0 0 !important;
  }

  /* Compose phones like the reference: front center-left, back right */
  .hero__phones {
    min-height: 520px !important;
    position: relative !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 !important;
  }

  .hero__phone--front {
    width: 300px !important;
    max-width: none !important;
    transform: rotate(-2deg) !important;
    margin-right: 40px !important;
    position: relative !important;
    z-index: 2 !important;
  }

  .hero__phone--back {
    width: 260px !important;
    max-width: none !important;
    position: absolute !important;
    top: 60px !important;
    right: 2% !important;
    transform: rotate(6deg) !important;
    z-index: 1 !important;
  }
}

/* ---------- TABLET LANDSCAPE (900 – 1024) ---------- */

@media (min-width: 901px) and (max-width: 1024px) {
  .hero__bg-red { height: 36% !important; }

  .hero__phone--front {
    width: 250px !important;
    max-width: none !important;
    margin-right: 30px !important;
  }
  .hero__phone--back {
    width: 220px !important;
    max-width: none !important;
    top: 50px !important;
    right: 2% !important;
  }
}

/* ---------- MOBILE / TABLET PORTRAIT (<= 900px) ---------- */

@media (max-width: 900px) {
  /* Bigger phone images on mobile */
  .hero__phones {
    min-height: 460px !important;
    padding: 12px 0 0 !important;
    position: relative !important;
  }

  .hero__phone--front {
    width: 220px !important;
    max-width: 62% !important;
    margin-right: 20px !important;
    transform: rotate(-2deg) !important;
  }

  .hero__phone--back {
    width: 200px !important;
    max-width: 56% !important;
    top: 24px !important;
    right: 0 !important;
    transform: translateX(12%) rotate(6deg) !important;
  }

  .hero__bg-red {
    height: 34% !important;
    border-radius: 24px 24px 0 0 !important;
  }
}

/* ---------- MOBILE (<= 640) ---------- */

@media (max-width: 640px) {
  .hero__phones {
    min-height: 420px !important;
    padding: 8px 0 0 !important;
  }

  .hero__phone--front {
    width: 200px !important;
    max-width: 68% !important;
    margin-right: 14px !important;
  }

  .hero__phone--back {
    width: 180px !important;
    max-width: 60% !important;
    top: 16px !important;
    right: 0 !important;
    transform: translateX(10%) rotate(6deg) !important;
  }

  .hero__bg-red {
    height: 32% !important;
    border-radius: 20px 20px 0 0 !important;
  }
}

/* ---------- SMALL MOBILE (<= 480) ---------- */

@media (max-width: 480px) {
  .hero__phones {
    min-height: 380px !important;
  }

  .hero__phone--front {
    width: 175px !important;
    max-width: 70% !important;
    margin-right: 10px !important;
  }

  .hero__phone--back {
    width: 155px !important;
    max-width: 62% !important;
    top: 12px !important;
    transform: translateX(8%) rotate(6deg) !important;
  }

  .hero__bg-red {
    height: 30% !important;
    border-radius: 16px 16px 0 0 !important;
  }
}

/* ---------- VERY SMALL (<= 360) ---------- */

@media (max-width: 360px) {
  .hero__phones { min-height: 340px !important; }

  .hero__phone--front {
    width: 150px !important;
    margin-right: 8px !important;
  }
  .hero__phone--back {
    width: 135px !important;
    top: 10px !important;
  }

  .hero__bg-red { height: 28% !important; }
}

/* ---------- MOBILE MEET SINGLES — bigger ---------- */

@media (max-width: 900px) {
  .meet__phones { gap: 14px !important; }
}

@media (max-width: 640px) {
  .meet__phones { gap: 10px !important; }
  .meet__phone { width: 100% !important; }
}

@media (max-width: 480px) {
  .meet__phones { gap: 8px !important; }
}

@media (max-width: 360px) {
  .meet__phones { gap: 6px !important; }
}

/* ---------- Bigger mobile hero avatars ---------- */

@media (max-width: 900px) {
  .hero__avatar { width: 42px !important; height: 42px !important; }
}

@media (max-width: 640px) {
  .hero__avatar { width: 38px !important; height: 38px !important; }
}

@media (max-width: 480px) {
  .hero__avatar { width: 36px !important; height: 36px !important; }
}

/* =========================================================
   HERO DESKTOP — FINAL COMPOSITION FIX
   Groups the two phones tightly, sits them ON the red band,
   matches the reference framing.
   ========================================================= */

/* Applies only to real desktop widths */
@media (min-width: 901px) {

  /* 1) Make phones a tight pair, not two floating islands */
  .hero__phones {
    position: relative !important;
    display: flex !important;
    align-items: flex-end !important;   /* phones sit at the BOTTOM */
    justify-content: center !important;
    min-height: 560px !important;
    padding: 0 0 40px !important;        /* breathing room at the bottom */
    overflow: visible !important;
  }

  /* FRONT phone — bigger, slightly left, tilted left, sits lowest */
  .hero__phone--front {
    position: relative !important;
    width: 320px !important;
    max-width: none !important;
    margin: 0 -30px 0 0 !important;      /* negative margin → overlaps the back phone */
    transform: rotate(-4deg) !important;
    transform-origin: bottom center !important;
    z-index: 2 !important;
  }

  /* BACK phone — smaller, sits to the right, higher, tilted right */
  .hero__phone--back {
    position: relative !important;       /* NOT absolute — so they stay grouped */
    width: 260px !important;
    max-width: none !important;
    top: auto !important;
    right: auto !important;
    margin: 0 0 40px -20px !important;   /* lift slightly, overlap toward front */
    transform: rotate(6deg) !important;
    transform-origin: bottom center !important;
    z-index: 1 !important;
  }

  /* 2) Red band sits directly under the phones */
  .hero__bg-red {
    height: 42% !important;
    border-radius: 32px 32px 0 0 !important;
    z-index: 0 !important;
  }
}

/* Tighten at large desktop */
@media (min-width: 1200px) {
  .hero__phone--front { width: 340px !important; }
  .hero__phone--back  { width: 275px !important; }
}

/* At the smaller end of desktop */
@media (min-width: 901px) and (max-width: 1100px) {
  .hero__phone--front { width: 280px !important; margin-right: -24px !important; }
  .hero__phone--back  { width: 230px !important; margin-left: -16px !important; margin-bottom: 30px !important; }
  .hero__bg-red { height: 40% !important; }
}

/* =========================================================
   AVATAR RESET — Unsplash images only
   Removes gradient + initials fallback from earlier layers
   ========================================================= */

.hero__avatar {
  position: relative;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  overflow: hidden;
  background: #ececf0 !important;         /* neutral fallback only while loading */
  border: 2px solid #fff;
  box-shadow: 0 2px 8px rgba(17, 17, 20, 0.12);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: -12px;
  flex-shrink: 0;
}

.hero__avatar:first-child { margin-left: 0; }

/* Kill the ::before initials fallback */
.hero__avatar::before { content: none !important; display: none !important; }

.hero__avatar img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
  z-index: 2;
}

/* Sizes across breakpoints */
@media (max-width: 900px) {
  .hero__avatar { width: 42px; height: 42px; }
}
@media (max-width: 640px) {
  .hero__avatar { width: 40px; height: 40px; border-width: 1.5px; }
}
@media (max-width: 480px) {
  .hero__avatar { width: 38px; height: 38px; margin-left: -10px; }
}
@media (max-width: 360px) {
  .hero__avatar { width: 34px; height: 34px; margin-left: -8px; }
}

/* =========================================================
   FOOTER — professional version
   Red brand band with columns, links, socials, legal row.
   ========================================================= */

.site-footer {
  background: var(--red);
  color: #fff;
  padding: 56px 32px 28px;
  margin-top: 0;
}

.site-footer__top {
  max-width: var(--container);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1.2fr 2.8fr;
  gap: 60px;
  padding-bottom: 40px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.18);
}

/* Brand column */
.site-footer__brand-col {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.site-footer .brand--footer {
  font-size: 24px;
  color: #fff;
  gap: 10px;
}
.site-footer .brand--footer .brand__icon {
  color: #fff;
  font-size: 28px;
}

.site-footer__tag {
  font-size: 14.5px;
  line-height: 1.55;
  opacity: 0.92;
  margin: 0;
  max-width: 260px;
}

/* Socials */
.site-footer__social {
  display: flex;
  gap: 12px;
  margin-top: 4px;
}

.site-footer__social a {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: #fff;
  transition: background 160ms ease, transform 160ms ease;
}
.site-footer__social a:hover {
  background: rgba(255, 255, 255, 0.32);
  transform: translateY(-2px);
}

/* Link columns */
.site-footer__cols {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
}

.site-footer__col-title {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.2px;
  margin: 0 0 16px;
  color: #fff;
  opacity: 0.95;
}

.site-footer__col-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.site-footer__col-list a {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.85);
  transition: color 140ms ease, opacity 140ms ease;
}
.site-footer__col-list a:hover {
  color: #fff;
  opacity: 1;
  text-decoration: underline;
  text-underline-offset: 3px;
}

/* Bottom bar */
.site-footer__bottom {
  max-width: var(--container);
  margin: 0 auto;
  padding-top: 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.85);
}

.site-footer__copy,
.site-footer__made {
  margin: 0;
}

.site-footer__made {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.site-footer__made-heart {
  color: #fff;
  font-size: 14px;
  opacity: 0.9;
}

/* ---------- Responsive ---------- */

@media (max-width: 1024px) {
  .site-footer { padding: 48px 24px 24px; }
  .site-footer__top { grid-template-columns: 1fr; gap: 40px; }
  .site-footer__brand-col { max-width: 420px; }
  .site-footer__cols { grid-template-columns: repeat(2, 1fr); gap: 28px; }
}

@media (max-width: 640px) {
  .site-footer { padding: 40px 20px 20px; }
  .site-footer__top { gap: 32px; padding-bottom: 32px; }
  .site-footer .brand--footer { font-size: 22px; }
  .site-footer__tag { max-width: 100%; font-size: 14px; }
  .site-footer__cols { grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .site-footer__col-title { font-size: 11.5px; margin-bottom: 12px; }
  .site-footer__col-list { gap: 10px; }
  .site-footer__col-list a { font-size: 13.5px; }
  .site-footer__bottom {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    font-size: 12.5px;
  }
}

@media (max-width: 480px) {
  .site-footer { padding: 36px 16px 18px; }
  .site-footer__cols { gap: 20px; }
  .site-footer__social a { width: 36px; height: 36px; font-size: 15px; }
}

@media (max-width: 360px) {
  .site-footer { padding: 32px 14px 16px; }
  .site-footer__cols { grid-template-columns: 1fr; gap: 22px; }
  .site-footer__social a { width: 34px; height: 34px; font-size: 14px; }
}
